{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anycode.dev/schemas/eval-baseline.json",
  "title": "anyCode Eval Baseline Summary",
  "type": "object",
  "required": [
    "schema_version",
    "product_version",
    "profile",
    "run_id",
    "created_at",
    "environment",
    "models",
    "summary",
    "risk_gate"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "product_version": { "type": "string" },
    "profile": { "type": "string", "enum": ["smoke", "release-candidate", "full"] },
    "run_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "properties": {
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "cpu": { "type": "string" },
        "ram_gb": { "type": "number" },
        "gpu": { "type": "string" }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alias", "model_id", "status"],
        "properties": {
          "alias": { "type": "string" },
          "model_id": { "type": "string" },
          "status": { "type": "string" },
          "tools": { "type": ["boolean", "null"] },
          "pass_rate": { "type": "number", "minimum": 0, "maximum": 100 },
          "avg_latency_ms": { "type": "number" },
          "cost_cny": { "type": "number" },
          "incompatible_suites": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed", "skipped", "pass_rate"],
      "properties": {
        "total": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "skipped": { "type": "integer" },
        "pass_rate": { "type": "number" },
        "duration_seconds": { "type": "number" }
      }
    },
    "risk_gate": {
      "type": "object",
      "required": ["coverage_rate", "gate_pass"],
      "properties": {
        "coverage_rate": { "type": "number" },
        "gate_pass": { "type": "boolean" },
        "uncovered_count": { "type": "integer" }
      }
    },
    "benchmarks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "pass_rate": { "type": "number" },
          "baseline_only": { "type": "boolean" }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
