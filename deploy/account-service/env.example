# K8s Secret — required at deploy time (never Docker build-args or git).
# WeChat PEM certs: separate Secret mounted at /app/wechat-certs (see scripts/create-k8s-wechat-secret.sh).

# Required keys for anycode-account-secrets:
# DATABASE_URL=mysql://USER:PASS@HOST:3306/anycode
# WECHAT_PAY_API_V3_KEY=<32-byte APIv3 key from WeChat merchant platform>
# WECHAT_PAY_APP_ID=<your app id>
# WECHAT_PAY_MCH_ID=<your merchant id>
# WECHAT_PAY_SERIAL_NO=<merchant API cert serial>
# SMTP_PASSWORD=...
# IDENTITY_ENCRYPTION_SECRET=...          # runtime secret, 32+ random chars
# AUDIT_ENCRYPTION_SECRET=...             # runtime secret, 32+ random chars
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USERNAME=billing@example.com

# Local docker-compose: copy to .env and run ./scripts/sync-wechat-certs.sh
# PEM files live in deploy/account-service/secrets/ (gitignored).

# Apply migration before/after deploy:
#   mysql ... < crates/account-service/migrations/009_account_identity_and_sessions.sql
#   mysql ... < crates/account-service/migrations/010_conversation_audit.sql

# Image tags: immutable $VERSION-$GIT_SHA + $VERSION + latest
# Rollback: kubectl set image deployment/anycode-account anycode-account=$REGISTRY:<previous-tag>
