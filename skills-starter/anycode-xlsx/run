#!/usr/bin/env python3
"""anycode-xlsx: workbook JSON → validate → preview → branded .xlsx."""
from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parent
REPO = SKILL_DIR.parents[1] if (SKILL_DIR.parents[1] / "brand-kits").is_dir() else SKILL_DIR.parents[2]
BRAND = "fde-editorial"


def emit_artifact(path: Path, kind: str, *, preview_path: Path | None = None) -> None:
    abs_path = path.resolve()
    payload: dict[str, object] = {
        "path": str(abs_path),
        "kind": kind,
        "title": abs_path.name,
        "inline": True,
    }
    if preview_path is not None:
        payload["preview_path"] = str(preview_path.resolve())
    print(str(abs_path))
    print(f"ANYCODE_ARTIFACT:{json.dumps(payload, ensure_ascii=False)}")
    sidecar = Path(f"{abs_path}.anycode-artifact.json")
    sidecar.write_text(json.dumps(payload, ensure_ascii=False) + "\n", encoding="utf-8")


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: run workbook.json [output.xlsx]", file=sys.stderr)
        return 1
    src = Path(sys.argv[1]).resolve()
    xlsx_out = Path(sys.argv[2]).resolve() if len(sys.argv) > 2 else src.with_suffix(".xlsx")
    preview = src.with_suffix(".preview.html")

    validator = REPO / "scripts" / "office" / "validate_workbook.py"
    preview_py = REPO / "scripts" / "office" / "build_workbook_preview.py"
    delivery = REPO / "scripts" / "office" / "build_xlsx_from_source.py"
    recheck = REPO / "scripts" / "office" / "recheck_xlsx.py"

    for step, cmd in [
        ("validate", [sys.executable, str(validator), str(src), "anycode-xlsx"]),
        ("preview", [sys.executable, str(preview_py), str(src)]),
        ("xlsx", [sys.executable, str(delivery), str(src), str(xlsx_out), BRAND]),
    ]:
        proc = subprocess.run(cmd, capture_output=True, text=True)
        if proc.returncode != 0:
            sys.stderr.write(f"[{step}] failed\n{proc.stderr or proc.stdout}")
            return proc.returncode
        if proc.stdout.strip():
            print(proc.stdout.strip())

    proc = subprocess.run(
        [sys.executable, str(recheck), str(xlsx_out)],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        sys.stderr.write(f"[recheck] failed\n{proc.stderr or proc.stdout}")
        return proc.returncode
    if proc.stdout.strip():
        print(proc.stdout.strip())

    print(f"workbook: {src}")
    print(f"preview: {preview}")
    print(f"xlsx: {xlsx_out}")
    emit_artifact(xlsx_out, "spreadsheet", preview_path=preview)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
