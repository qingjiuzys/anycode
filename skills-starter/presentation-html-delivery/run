#!/usr/bin/env python3
"""Deprecated wrapper: design + commercial export."""
from __future__ import annotations

import subprocess
import sys
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parent
REPO = SKILL_DIR.parents[1] if (SKILL_DIR.parents[1] / "brand-kits").is_dir() else SKILL_DIR.parents[2]


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: run slides_dir [output.pptx] [brand_kit]", file=sys.stderr)
        return 1
    src = Path(sys.argv[1]).resolve()
    out = Path(sys.argv[2]).resolve() if len(sys.argv) > 2 else Path.cwd() / "deck.pptx"
    brand = sys.argv[3] if len(sys.argv) > 3 else "lingqi"
    design = REPO / "skills-starter" / "presentation-design" / "run"
    commercial = REPO / "skills-starter" / "presentation-commercial-delivery" / "run"
    proc = subprocess.run([sys.executable, str(design), str(src), brand], capture_output=True, text=True)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr or proc.stdout)
        return proc.returncode
    if proc.stdout.strip():
        print(proc.stdout.strip())
    proc = subprocess.run([sys.executable, str(commercial), str(src), str(out), brand], capture_output=True, text=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
