#!/usr/bin/env python3
"""anycode-pdf: MD template → validate → HTML preview → PDF."""
from __future__ import annotations

import subprocess
import sys
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parent
REPO = SKILL_DIR.parents[1] if (SKILL_DIR.parents[1] / "brand-kits").is_dir() else SKILL_DIR.parents[2]


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: run report.md [output.pdf]", file=sys.stderr)
        return 1
    src = Path(sys.argv[1]).resolve()
    pdf_out = Path(sys.argv[2]).resolve() if len(sys.argv) > 2 else src.with_suffix(".pdf")
    preview = src.with_suffix(".preview.html")

    validator = REPO / "scripts" / "office" / "validate_report_md.py"
    preview_py = REPO / "scripts" / "office" / "build_md_preview.py"
    pdf_py = REPO / "scripts" / "office" / "html_to_pdf.py"

    for step, cmd in [
        ("validate", [sys.executable, str(validator), str(src), "anycode-pdf"]),
        ("preview", [sys.executable, str(preview_py), str(src)]),
        ("pdf", [sys.executable, str(pdf_py), str(preview), str(pdf_out)]),
    ]:
        proc = subprocess.run(cmd, capture_output=True, text=True)
        if proc.returncode != 0:
            sys.stderr.write(f"[{step}] failed\n{proc.stderr or proc.stdout}")
            return proc.returncode
        if proc.stdout.strip():
            print(proc.stdout.strip())

    print(f"report: {src}")
    print(f"preview: {preview}")
    print(f"pdf: {pdf_out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
