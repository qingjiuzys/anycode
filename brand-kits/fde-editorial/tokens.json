{
  "id": "fde-editorial",
  "name": "FDE Editorial (参考页对齐)",
  "version": "1.0.0",
  "source_note": "Extracted from digital-fde-platform/class/schedule (index.html + styles.css). Editorial Swiss-grid style: light warm-gray canvas, near-black ink, electric blue accent, Chinese serif display type.",
  "colors": {
    "primary": "#231f20",
    "primary_light": "#4a4446",
    "accent": "#1400ff",
    "accent_soft": "#7d8cff",
    "accent_warm": "#f24e54",
    "surface": "#f2f5f0",
    "surface_alt": "#ffffff",
    "header_fill": "#231f20",
    "header_text": "#f2f5f0",
    "body_text": "#231f20",
    "muted_text": "#767573",
    "highlight_row": "#E8EAE6",
    "grid_line": "#E1E4DF",
    "link": "#1400ff"
  },
  "semantic_palette": {
    "arch": "#1400ff",
    "frontend": "#f24e54",
    "backend": "#5f52a0",
    "database": "#1cd5b0",
    "cloud": "#f5a947",
    "llm": "#e0479e",
    "agent": "#2f9e44"
  },
  "fonts": {
    "heading_zh": "Songti SC",
    "heading_en": "STSong",
    "body_zh": "PingFang SC",
    "body_en": "-apple-system",
    "mono": "SF Mono"
  },
  "typography": {
    "display_weight": 900,
    "display_family": "serif",
    "label_style": "mono uppercase letterspaced",
    "label_letter_spacing_em": 0.14,
    "body_size_px": 16,
    "body_line_height": 1.7
  },
  "motifs": [
    "6px solid ink rule (section borders, label underline)",
    "hairline 1px grid (tables, cards, ladders)",
    "mono uppercase micro-labels with accent numerals (00 / 01 / ...)",
    "serif 900 display headlines with thin gray secondary line",
    "invert-on-hover blocks, accent final-state highlight",
    "light sections alternating with full-ink dark sections",
    "generous whitespace: 100px section padding, 1120px max wrap"
  ],
  "spacing": {
    "slide_margin_in": 0.6,
    "section_gap_pt": 18,
    "bullet_indent_in": 0.3
  },
  "slide": {
    "width_px": 1920,
    "height_px": 1080,
    "aspect": "16:9"
  }
}
