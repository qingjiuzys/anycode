{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnyCode Harness DAG v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "nodes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "max_parallel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "kind": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "work"
                  },
                  "agent": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 131072
                  }
                },
                "required": [
                  "type",
                  "agent",
                  "prompt"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "gate"
                  },
                  "verifier": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "type",
                  "verifier"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "human"
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  }
                },
                "required": [
                  "type",
                  "question"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "branch"
                  },
                  "source": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,64}$"
                  },
                  "pointer": {
                    "type": "string"
                  },
                  "equals": {}
                },
                "required": [
                  "type",
                  "source",
                  "pointer",
                  "equals"
                ]
              }
            ]
          },
          "join": {
            "enum": [
              "all",
              "any"
            ]
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "node"
              ],
              "properties": {
                "node": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "on": {
                  "enum": [
                    "completed",
                    "true",
                    "false"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
