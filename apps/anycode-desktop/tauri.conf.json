{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "anyCode",
  "version": "0.2.4",
  "identifier": "dev.anycode.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../../crates/dashboard-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "anyCode Workbench",
        "width": 1280,
        "height": 840,
        "url": "loading.html",
        "visible": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/bin/*",
      "resources/browser/",
      "resources/project-templates/",
      "resources/skills-starter/",
      "resources/dashboard-ui/"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "-",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "anycode"
        ]
      }
    },
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://github.com/qingjiuzys/anycode/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
