{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the Workbench window (loopback API + external docs)",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "shell:default",
    "shell-helpers-default",
    "apple-media-default",
    "harness-pairing-default",
    "cef-embed-default",
    "deep-link:default",
    "updater:default",
    "process:allow-restart"
  ]
}
