#!/usr/bin/env python3
"""Build a branded .pptx from Markdown outline (fallback when HTML path unavailable)."""
from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

try:
    from pptx import Presentation
    from pptx.dml.color import RGBColor
    from pptx.util import Inches, Pt
except ImportError:
    print("ERROR: python-pptx not installed. Run: pip install python-pptx", file=sys.stderr)
    sys.exit(2)

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO / "brand-kits" / "lib"))
from brand_kit import color_from_tokens, emit_artifact, find_brand_kit, load_tokens  # noqa: E402


def parse_outline(text: str) -> list[tuple[str, list[str]]]:
    slides: list[tuple[str, list[str]]] = []
    title: str | None = None
    bullets: list[str] = []
    for line in text.splitlines():
        if line.startswith("## "):
            if title:
                slides.append((title, bullets))
            title = line[3:].strip()
            bullets = []
        elif line.strip().startswith(("- ", "* ")):
            if title:
                bullets.append(line.strip()[2:].strip())
    if title:
        slides.append((title, bullets))
    return slides


def add_branded_slide(prs, title: str, bullets: list[str], tokens: dict, *, cover: bool = False):
    layout = prs.slide_layouts[6] if len(prs.slide_layouts) > 6 else prs.slide_layouts[0]
    slide = prs.slides.add_slide(layout)
    bg = slide.shapes.add_shape(1, Inches(0), Inches(0), prs.slide_width, prs.slide_height)
    if cover:
        bg.fill.solid()
        bg.fill.fore_color.rgb = RGBColor(*color_from_tokens(tokens, "primary"))
    else:
        bg.fill.solid()
        bg.fill.fore_color.rgb = RGBColor(255, 255, 255)
    bg.line.fill.background()
    bar = slide.shapes.add_shape(1, Inches(0), Inches(0), Inches(0.1), prs.slide_height)
    bar.fill.solid()
    bar.fill.fore_color.rgb = RGBColor(*color_from_tokens(tokens, "accent"))
    bar.line.fill.background()
    tbox = slide.shapes.add_textbox(Inches(0.7), Inches(0.5 if not cover else 2.2), Inches(11.5), Inches(1))
    tf = tbox.text_frame
    p = tf.paragraphs[0]
    p.text = title
    p.font.size = Pt(36 if cover else 28)
    p.font.bold = True
    p.font.color.rgb = RGBColor(*(color_from_tokens(tokens, "header_text") if cover else color_from_tokens(tokens, "primary")))
    y = Inches(1.6 if not cover else 3.4)
    for i, b in enumerate(bullets[:5]):
        bx = slide.shapes.add_textbox(Inches(0.9), y + Inches(i * 0.55), Inches(11), Inches(0.45))
        bp = bx.text_frame.paragraphs[0]
        bp.text = f"• {b}"
        bp.font.size = Pt(18)
        bp.font.color.rgb = RGBColor(*color_from_tokens(tokens, "body_text"))


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: run outline.md [output.pptx] [brand_kit]", file=sys.stderr)
        return 1
    outline_path = Path(sys.argv[1]).resolve()
    out_path = (
        Path(sys.argv[2]).resolve()
        if len(sys.argv) > 2
        else outline_path.with_suffix(".pptx")
    )
    brand = sys.argv[3] if len(sys.argv) > 3 else "fde-editorial"
    tokens = load_tokens(find_brand_kit(brand))
    slides = parse_outline(outline_path.read_text(encoding="utf-8"))
    if not slides:
        print("ERROR: no ## slide headings found in outline", file=sys.stderr)
        return 1

    prs = Presentation()
    prs.slide_width = Inches(13.333)
    prs.slide_height = Inches(7.5)
    for i, (title, bullets) in enumerate(slides):
        add_branded_slide(prs, title, bullets, tokens, cover=(i == 0))

    out_path.parent.mkdir(parents=True, exist_ok=True)
    prs.save(str(out_path))
    emit_artifact(out_path, "presentation")

    renderer = REPO / "scripts" / "office" / "render_pptx_evidence.py"
    if renderer.is_file():
        subprocess.run(
            [sys.executable, str(renderer), str(out_path), str(out_path.parent / "evidence")],
            check=False,
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
